msgid "A cookie kis adatfájl, amelyet a böngésző tárol. Segíti a weboldal működését, a beállítások megjegyzését és – hozzájárulás esetén – a látogatottsági statisztikát."
msgstr "A cookie is a small data file stored by the browser. It helps the website function, remembers settings, and – with consent – tracks visitor statistics."

msgid "A demo tartalom sikeresen betöltve. Frissítse a főoldalt a böngészőben."
msgstr ""

msgid "A dokumentum nem ehhez az ajánlatkéréshez tartozik."
msgstr "The document does not belong to this quote request."

msgid "A dokumentum nem található."
msgstr "Document not found."

msgid "A dokumentum törlése sikertelen."
msgstr "Deleting the document failed."

msgid "A feladat"
msgstr "The task"

msgid "A felhasználó felelős a hozzáférési adatok biztonságáért, és csak a saját adataihoz férhet hozzá."
msgstr "The user is responsible for the security of their access data and may only access their own data."

msgid "A felhasználó felelőssége, hogy a megadott adatok tudomása szerint pontosak és teljesek legyenek."
msgstr "It is the user's responsibility to ensure that the data provided is accurate and complete to the best of their knowledge."

msgid "A feltöltési könyvtár nem írható. Kérjük, jelezze az üzemeltetőnek."
msgstr "The upload folder is not writable. Please tell the site operator."

msgid "A feltöltött dokumentumokat kizárólag az adott ajánlatkérés vagy szolgáltatás kezelése céljából használjuk. Kérjük, csak a projekthez szükséges adatokat töltse fel."
msgstr "Uploaded documents are used solely for the purpose of managing the specific quote request or service. Please upload only the data necessary for the project."

msgid "A fizetéshez be kell jelentkeznie, és érvényes ajánlathoz kell rendelkeznie."
msgstr "To make a payment, you must log in and have a valid quote."

msgid "A fájl feltöltése sikertelen."
msgstr "The file upload failed."

msgid "A fájl túl nagy (max. 20 MB)."
msgstr "The file is too large (max. 20 MB)."

msgid "A jelen feltételek a weboldal használatára, a kapcsolatfelvételre és az ajánlatkérésre vonatkoznak."
msgstr "These terms apply to the use of the website, making contact, and requesting quotes."

msgid "A kapcsolat oldalon OpenStreetMap csempéket jelenítünk meg (Leaflet). A térkép csak hozzájárulás után vagy a „Térkép betöltése” gombra kattintva töltődik be. Az „Útvonaltervezés” az OpenStreetMap irányító oldalára vezet (külső oldal)."
msgstr "On the contact page, we display OpenStreetMap tiles (Leaflet). The map only loads after consent or by clicking the „Load Map” button. The „Route Planning” leads to the OpenStreetMap direction page (external site)."

msgid "A kiválasztott elemeket még nem adta hozzá az ajánlatkéréshez"
msgstr "You have not yet added the selected items to the quote request."

msgid "A kiválasztott elemeket még nem adta hozzá az ajánlatkéréshez. A folytatás előtt kattintson a gombra."
msgstr "You have not yet added the selected items to the quote request. Click the button before continuing."

msgid "A kiválasztott elemeket még nem adta hozzá az ajánlatkéréshez. Tovább lép?"
msgstr "You have not added the selected items to the quote request yet. Continue?"

msgid "A kiválasztás bármikor módosítható a beküldésig. Az ajánlatkérés nem jár kötelezettséggel."
msgstr "You can change your selection any time before submitting. Requesting a quote is without obligation."

msgid "A kosár üres. Az ajánlatkéréshez először válasszon szolgáltatást."
msgstr "Your cart is empty. To request a quote, please choose a service first."

msgid "A kosár üres. Válasszon szolgáltatást a folytatáshoz."
msgstr "The cart is empty. Please select a service to continue."

msgid "A kártyás fizetés jelenleg nem elérhető. Kérjük, válassza a banki utalást."
msgstr "Card payment is currently unavailable. Please choose bank transfer."

msgid "A kész terveket a megrendelt szolgáltatáselemekhez külön töltse fel. Az ügyfélportálon is elemenként jelennek meg."
msgstr ""

msgid "A kész terveket az ügyfélportálon adjuk át, a kapcsolódó dokumentumokkal együtt."
msgstr "We hand over the finished plans in the client portal, together with the related documents."

msgid "A lista a referencia-adatbázisból töltődik; itt a jelenlegi oldalon szereplő projektek láthatók. Új projekt felvételekor automatikusan megjelenik a szűrőkben is."
msgstr "The list is loaded from the reference database; the projects shown here are the ones on the current site. A new project automatically appears in the filters as well."

msgid "A lábléc feletti cookie sávon választhat: „Csak szükséges” vagy „Összes elfogadása”. A beállítás a böngészőben marad; törléséhez törölje az oldal adatait / localStorage-t, majd töltse újra az oldalt."
msgstr "In the cookie bar above the footer, you can choose: „Necessary only” or „Accept all”. The setting remains in the browser; to delete it, clear the page data / localStorage and then reload the page."

