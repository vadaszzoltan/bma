msgstr "You choose the sub-tasks, enter the project details and upload the documents you have."

msgid "Kiválasztott tételek"
msgstr "Selected items"

msgid "Kiválasztás módosítása"
msgstr "Change selection"

msgid "Kosár"
msgstr "Cart"

msgid "Kártyás fizetés (Stripe)"
msgstr "Card payment (Stripe)"

msgid "Képek"
msgstr "Images"

msgid "Kérjen ajánlatot"
msgstr "Request a quote"

msgid "Később is pótolható"
msgstr "Can be added later"

msgid "Köszönjük, megkaptuk az ajánlatkérését"
msgstr "Thank you, we have received your quote request"

msgid "Közmű-koordináció: Áram-, gáz- és vízszolgáltatói egyeztetések\nTervezés: Csatlakozási tervek készítése"
msgstr "Utility coordination: Consultations with electricity, gas and water providers\nDesign: Preparing the connection plans"

msgid "Lakossági és üzleti projektekhez"
msgstr "For residential and business projects"

msgid "Legalább egy tételt válasszon ki a továbblépéshez."
msgstr "Select at least one item to continue."

msgid "Letöltés"
msgstr "Download"

msgid "Menü bezárása"
msgstr "Close menu"

msgid "Meta: _bma_duration – az „Amit csináltunk” blokk utolsó sora."
msgstr "Meta: _bma_duration – the last row of the “What we did” block."

msgid "Meta: _bma_result – üresen a szekció nem jelenik meg."
msgstr "Meta: _bma_result – if empty, the section is not shown."

msgid "Meta: _bma_task – üresen a szekció nem jelenik meg."
msgstr "Meta: _bma_task – if empty, the section is not shown."

msgid "Meta: _bma_work – soronként „Címke: szöveg”. Üresen a szekció kimarad."
msgstr "Meta: _bma_work – one “Label: text” per line. If empty, the section is omitted."

msgid "Minden kiválasztott tételre vonatkozik"
msgstr "Applies to every selected item"

msgid "Mire lesz szükség?"
msgstr "What will you need?"

msgid "Mire lesz szükség? – Ha rendelkezésre áll"
msgstr "What will you need? – If available"

msgid "Mire lesz szükség? – Később is pótolható"
msgstr "What will you need? – Can be added later"

msgid "Mire lesz szükség? – Kötelező"
msgstr "What will you need? – Required"

msgid "Mit tartalmaz a(z) %s?"
msgstr "What does %s include?"

msgid "Mobil menü"
msgstr "Mobile menu"

msgid "Most"
msgstr "Now"

msgid "Még nem választott tételt. Jelölje be bal oldalon, mire van szüksége – bármennyi tétel egy ajánlatkérésbe kerülhet."
msgstr "You have not selected any items yet. Tick what you need on the left – any number of items can go into one request."

msgid "Még nincs dokumentum ehhez a kéréshez."
msgstr "There are no documents for this request yet."

msgid "Még nincs feltöltött vagy kapott dokumentum."
msgstr "No uploaded or received documents yet."

msgid "Még nincs státuszváltozás."
msgstr "No status changes yet."

msgid "Nem baj, ha nincs meg minden. Az ajánlatkéréshez elég annyi, amennyi rendelkezésére áll – a többit menet közben pótoljuk."
msgstr "It is fine if you do not have everything. Whatever you have is enough for the request – we will fill in the rest as we go."

msgid "Nem találja, amire szüksége van?"
msgstr "Can't find what you need?"

msgid "Nincs kiválasztott tétel."
msgstr "No items selected."

msgid "Nincs megadott projektadat."
msgstr "No project details provided."

msgid "Nyelv választása"
msgstr "Choose language"

msgid "PDF, DWG, JPG, DOCX · legfeljebb %d MB"
msgstr "PDF, DWG, JPG, DOCX · max. %d MB"

msgid "PDF, DWG, JPG, DOCX · legfeljebb %d MB / fájl"
msgstr "PDF, DWG, JPG, DOCX · max. %d MB per file"

