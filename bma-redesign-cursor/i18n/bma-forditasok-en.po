msgstr "Services: %s"

msgid "Szűrés típus és szolgáltatás szerint"
msgstr "Filter by type and service"

msgid "Teendő: ajánlat elfogadása"
msgstr "To do: accept the quote"

msgid "Teendő: díjbekérő rendezése"
msgstr "To do: pay the proforma invoice"

msgid "Terv elérhető"
msgstr "Plan available"

msgid "Tervek készítése folyamatban"
msgstr "Plans in preparation"

msgid "Tervrajzok, dokumentumok"
msgstr "Drawings, documents"

msgid "Tipikus átfutás: [X–Y] hét"
msgstr "Typical turnaround: [X–Y] weeks"

msgid "Tovább"
msgstr "Continue"

msgid "Tovább az adatokhoz"
msgstr "Continue to details"

msgid "További megjegyzés"
msgstr "Additional notes"

msgid "További projektek"
msgstr "More projects"

msgid "Tétel"
msgstr "Item"

msgid "Tétel eltávolítása"
msgstr "Remove item"

msgid "Tételenkénti adatok"
msgstr "Per-item details"

msgid "Típus"
msgstr "Type"

msgid "Típus: %s"
msgstr "Type: %s"

msgid "Vissza"
msgstr "Back"

msgid "Vissza a szolgáltatásokhoz"
msgstr "Back to services"

msgid "Visszaigazolás"
msgstr "Confirmation"

msgid "Visszajelzés [X] munkanapon belül, kötelezettség nélkül."
msgstr "Reply within [X] working days, no obligation."

msgid "Válassza ki a szükséges részfeladatokat, és néhány adat megadásával kérjen ajánlatot. Az ajánlatkérés díjmentes és nem jár kötelezettséggel."
msgstr "Choose the sub-tasks you need and request a quote by filling in a few details. It is free and without obligation."

msgid "Válassza ki a szükséges szolgáltatásokat, adja meg a projekt alapadatait, és néhány napon belül személyre szabott ajánlatot küldünk."
msgstr "Choose the services you need, enter the project details, and we will send a tailored quote within a few days."

msgid "Válassza ki azokat a tételeket, amelyekre a projektjéhez szüksége van. Bármelyik kombinálható a többi szolgáltatási területtel."
msgstr "Choose the items your project needs. Any of them can be combined with the other service areas."

msgid "Válogatás megvalósult tervezési, engedélyeztetési, közmű-koordinációs és dokumentációs munkáinkból. Szűrjön projekttípus vagy szolgáltatás szerint."
msgstr "A selection of our completed design, permitting, utility coordination and documentation work. Filter by project type or service."

msgid "[X] munkanapon belül"
msgstr "Within [X] working days"

msgid "az ajánlat %d napig érvényes"
msgstr "the quote is valid for %d days"

msgid "nev@example.com"
msgstr "name@example.com"

msgid "pl. 3 hónap"
msgstr "e.g. 3 months"

msgid "Állítsa össze, mire van szüksége, és néhány adat megadásával kérjen személyre szabott ajánlatot."
msgstr "Put together what you need and request a tailored quote by filling in a few details."

msgid "Átadás"
msgstr "Handover"

msgid "Átfutás"
msgstr "Turnaround"

msgid "Átnézzük a megadott adatokat, és ha szükséges, egyeztetünk a hiányzó részletekről."
msgstr "We review the details you provided and, if needed, discuss anything missing."

msgid "Átnézzük az adatokat, szükség esetén egyeztetünk, majd elkészítjük az ajánlatot."
msgstr "We review the details, consult if needed, then prepare the quote."

msgid "Érvénytelen beküldés. Frissítse az oldalt, és próbálja újra."
msgstr "Invalid submission. Please refresh the page and try again."

msgid "Év: %s"
msgstr "Year: %s"

msgid "Írja le röviden a projektet, és segítünk összeállítani a szükséges tételeket."
msgstr "Briefly describe the project and we will help you put together the items you need."

