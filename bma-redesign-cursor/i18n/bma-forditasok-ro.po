msgstr "Meta: _bma_duration – ultimul rând din blocul „Ce am făcut”."

msgid "Meta: _bma_result – üresen a szekció nem jelenik meg."
msgstr "Meta: _bma_result – dacă este gol, secțiunea nu apare."

msgid "Meta: _bma_task – üresen a szekció nem jelenik meg."
msgstr "Meta: _bma_task – dacă este gol, secțiunea nu apare."

msgid "Meta: _bma_work – soronként „Címke: szöveg”. Üresen a szekció kimarad."
msgstr "Meta: _bma_work – pe fiecare rând „Etichetă: text”. Dacă este gol, secțiunea lipsește."

msgid "Minden kiválasztott tételre vonatkozik"
msgstr "Se aplică tuturor pozițiilor selectate"

msgid "Mire lesz szükség?"
msgstr "De ce veți avea nevoie?"

msgid "Mire lesz szükség? – Ha rendelkezésre áll"
msgstr "De ce veți avea nevoie? – Dacă este disponibil"

msgid "Mire lesz szükség? – Később is pótolható"
msgstr "De ce veți avea nevoie? – Poate fi completat ulterior"

msgid "Mire lesz szükség? – Kötelező"
msgstr "De ce veți avea nevoie? – Obligatoriu"

msgid "Mit tartalmaz a(z) %s?"
msgstr "Ce include %s?"

msgid "Mobil menü"
msgstr "Meniu mobil"

msgid "Most"
msgstr "Acum"

