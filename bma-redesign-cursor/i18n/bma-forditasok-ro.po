msgstr "Gratuit, fără obligații"

msgid "E-mailben elküldtük a kérés összefoglalóját és a feltöltött dokumentumok listáját."
msgstr "V-am trimis pe e-mail rezumatul cererii și lista documentelor încărcate."

msgid "Ebben a nézetben most nincs ajánlatkérés."
msgstr "În această vizualizare nu există cereri de ofertă."

msgid "Egy sor = egy tétel"
msgstr "Un rând = o poziție"

msgid "Ehhez a kéréshez nincs hozzáférése."
msgstr "Nu aveți acces la această cerere."

msgid "Ehhez kapcsolódó szolgáltatások"
msgstr "Servicii asociate"

msgid "Ellenőrizze a kiválasztott tételeket, és adja meg a tételenkénti adatokat. A projekt közös adatait a következő lépésben kérjük."
msgstr "Verificați pozițiile selectate și completați datele aferente fiecărei poziții. Datele generale ale proiectului le solicităm la pasul următor."

msgid "Ellenőrzés"
msgstr "Verificare"

msgid "Elolvastam és elfogadom az <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">adatkezelési tájékoztatót</a>."
msgstr "Am citit și accept <a href=\"%s\" target=\"_blank\" rel=\"noopener noreferrer\">politica de confidențialitate</a>."

msgid "Előkészítés"
msgstr "Pregătire"

msgid "Ez a bma_reference_category taxonómia (lista szűrő: ?tipus=…)."
msgstr "Aceasta este taxonomia bma_reference_category (filtru listă: ?tipus=…)."

msgid "Ez az ajánlatkérés már be lett küldve. Frissítse az oldalt."
msgstr "Această cerere a fost deja trimisă. Reîmprospătați pagina."

msgid "Ezután"
msgstr "În continuare"

msgid "Ezzel a szűréssel nincs találat. Próbáljon másik típust vagy szolgáltatást, vagy állítsa vissza a szűrőt „Összes”-re."
msgstr "Niciun rezultat pentru acest filtru. Încercați alt tip sau alt serviciu ori reveniți la „Toate”."

